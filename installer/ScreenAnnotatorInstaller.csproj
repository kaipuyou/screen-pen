<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\ScreenAnnotator\Assets\ScreenAnnotator.ico</ApplicationIcon>
    <AssemblyName>屏幕笔安装包</AssemblyName>
    <RootNamespace>ScreenAnnotatorInstaller</RootNamespace>
    <Version>1.0.0</Version>
    <Product>屏幕笔安装包</Product>
    <Company>知溯工具</Company>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Payload\ScreenAnnotator.exe" LogicalName="Payload.ScreenAnnotator.exe" />
    <EmbeddedResource Include="..\ScreenAnnotator\Assets\ScreenAnnotator.ico" LogicalName="Payload.ScreenAnnotator.ico" />
  </ItemGroup>
</Project>
